APP_NAME="Aula Segura API"
APP_ENV="development"
APP_DEBUG=true
APP_VERSION="1.0.0"

DATABASE_URL="mysql+pymysql://root:root123@localhost:3306/aula_segura"
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

